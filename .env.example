# Local preview server reads PORT from the process environment (default: 4173).
# This project does not automatically load .env files.

# Before launch, set the approved counter ID in assets/site-config.js (leave blank until approved).
# Yandex Metrika is loaded only after the visitor opts into analytics cookies.

# CRM-side settings, documented here for the eventual CRM deployment only:
# S4_PRIVATE_FILES_MODE=enabled
# CORS_ORIGINS=https://vorota-vl.ru,https://www.vorota-vl.ru
# VITE_S4_PRIVATE_FILES_MODE=enabled
